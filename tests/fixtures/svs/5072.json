    {
      "id": 311994,
      "url": "http://svs.gsfc.nasa.gov/5072/#media_group_311994",
      "widget": "Basic text with HTML",
      "title": "",
      "caption": "",
      "description": "These simple visualizations are plots of time vs. wind speed for each tropical storm/hurricane of Atlantic Hurricane seasons from 1950 to the present. Horizontal lines indicate wind speed category thresholds. A line plot for each storm shows the storm's name and a marker at the peak wind speed.<p><br><br>Most named storms during the Atlantic hurricane season happen between June and November.  However, occasionally, storms develop outside of those ranges.<br><br>Four versions of the plots are inluded:<br>   1. May to December showig only the current year<br>   2. May to December showing the current year and strong storms from previous years (ghosted out)<br>   3. January to December showig only the current year<br>   4. January to December showing the current year and strong storms from previous years (ghosted out)<br>     <br><b>The plot for the current year automatically updates every 2 hours during hurricane season.</b>",
      "items": [],
      "extra_data": {}
    },
